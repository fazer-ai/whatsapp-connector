-	if ring.primed && ring.seen[word]&(1<<bit) != 0 && ring.seq[slot] == seq {
-		return true
-	}
 	ring.primed = true
 	ring.seen[word] |= 1 << bit
 	ring.seq[slot] = seq
-	return false
 }
