# Secrets for the example composes. Generate each with: openssl rand -hex 32
SECRET_KEY_BASE=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Only the separate-container example reads this one: the embedded connector makes its own
WAC_MEDIA_TOKEN=

# Where Chatwoot is reached from a browser
FRONTEND_URL=http://localhost:3000
# The public address of this host, announced to browsers for the media of WhatsApp calls
# (UDP port 40000). Leave empty when the browsers reach the host at its own address.
WAC_CALLS_PUBLIC_IP=
# Image tags; pin them to a release in production
# CHATWOOT_TAG=latest
# WAC_TAG=latest
